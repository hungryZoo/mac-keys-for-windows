<Window x:Class="MacKeys.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="실행 중인 프로세스"
        Width="760"
        Height="520"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Malgun Gothic, Segoe UI"
        FontSize="13">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Style="{StaticResource Muted}"
                   Margin="0,0,0,10"
                   Text="지금 실행 중인 프로세스입니다. 고른 항목의 이름과 경로를 그대로 넣습니다." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="추가" Style="{StaticResource PrimaryButton}" Click="AddClick" AutomationProperties.AutomationId="AddRunningProcess" />
            <Button Content="취소" Style="{StaticResource ActionButton}" Margin="0" IsCancel="True" />
        </StackPanel>
        <Border BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="4"
                Background="{DynamicResource ListBackground}"
                ClipToBounds="True"
                SnapsToDevicePixels="True">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource ButtonBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="0,0,0,1">
                    <Grid Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="프로세스" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                        <Border Grid.Column="1" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0">
                            <TextBlock Text="창" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                        </Border>
                        <Border Grid.Column="2" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0">
                            <TextBlock Text="경로" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                        </Border>
                    </Grid>
                </Border>
                <ListBox x:Name="Rows"
                         MouseDoubleClick="RowDoubleClick"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource TableRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.AutomationId="RunningProcessList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ProcessName}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="10,6"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="1" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0" Padding="10,6">
                                    <TextBlock Text="{Binding WindowTitle}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding WindowTitle}" />
                                </Border>
                                <Border Grid.Column="2" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0" Padding="10,6">
                                    <TextBlock Text="{Binding PathText}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding PathText}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
