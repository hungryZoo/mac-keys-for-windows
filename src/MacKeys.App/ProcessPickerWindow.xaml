<Window x:Class="MacKeys.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="실행 중인 프로세스"
        Width="760"
        Height="520"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Malgun Gothic, Segoe UI"
        FontSize="13">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Style="{StaticResource Muted}"
                   Margin="0,0,0,10"
                   Text="지금 실행 중인 프로세스입니다. 고른 항목의 이름과 경로를 그대로 넣습니다." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="추가" Style="{StaticResource PrimaryButton}" Click="AddClick" AutomationProperties.AutomationId="AddRunningProcess" />
            <Button Content="취소" Style="{StaticResource ActionButton}" Margin="0" IsCancel="True" />
        </StackPanel>
        <ListView x:Name="Rows"
                  MouseDoubleClick="RowDoubleClick"
                  Background="{DynamicResource ListBackground}"
                  Foreground="{DynamicResource TextPrimary}"
                  BorderBrush="{DynamicResource CardBorder}"
                  AutomationProperties.AutomationId="RunningProcessList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="프로세스" Width="170" DisplayMemberBinding="{Binding ProcessName}" />
                    <GridViewColumn Header="창" Width="180" DisplayMemberBinding="{Binding WindowTitle}" />
                    <GridViewColumn Header="경로" Width="340" DisplayMemberBinding="{Binding PathText}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
