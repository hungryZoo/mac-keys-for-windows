<Window x:Class="MacKeys.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mac Keys for Windows"
        Width="1120"
        Height="760"
        MinWidth="1040"
        MinHeight="720"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Malgun Gothic, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" Margin="20,8,20,0" Background="Transparent" />
                            <Border Grid.Row="1" Background="Transparent">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <TabControl>
        <TabItem Header="홈" AutomationProperties.Name="홈" AutomationProperties.AutomationId="HomeTab">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">
                    <TextBlock x:Name="PowerHeadline"
                               Text="적용 중"
                               FontSize="56"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               AutomationProperties.AutomationId="PowerHeadline" />
                    <TextBlock x:Name="ProfileStatusText"
                               Text="현재: 맥단축키"
                               FontSize="22"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               AutomationProperties.AutomationId="ProfileStatus" />
                    <TextBlock x:Name="ForegroundStatusText"
                               Style="{StaticResource Muted}"
                               FontSize="14"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               AutomationProperties.AutomationId="ForegroundStatus" />
                    <TextBlock x:Name="HomeEngineText"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,14,0,0"
                               Visibility="Collapsed"
                               AutomationProperties.AutomationId="HomeEngineStatus" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                        <Button x:Name="ApplyButton"
                                Content="적용하기"
                                Style="{StaticResource HomePrimaryButton}"
                                Click="ApplyClick"
                                AutomationProperties.AutomationId="ApplyButton" />
                        <Button x:Name="SuspendButton"
                                Content="끄기"
                                Style="{StaticResource HomeButton}"
                                Click="SuspendClick"
                                AutomationProperties.AutomationId="SuspendButton" />
                    </StackPanel>
                    <TextBlock x:Name="HomeActionText"
                               Style="{StaticResource Muted}"
                               Margin="0,18,0,0"
                               TextAlignment="Center"
                               AutomationProperties.AutomationId="HomeActionStatus" />
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="설정" AutomationProperties.Name="설정" AutomationProperties.AutomationId="SettingsTab">
            <Grid x:Name="SettingsRoot" Margin="20,4,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="InstallStatusText" TextWrapping="Wrap" AutomationProperties.AutomationId="InstallStatus" />
                            <TextBlock x:Name="EngineStatusText" Margin="0,2,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="EngineStatus" />
                            <TextBlock x:Name="ExePathText" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="OpenSettingsButton"
                                Grid.Column="1"
                                Content="Keyboard Manager 설정 열기"
                                Style="{StaticResource ActionButton}"
                                Margin="0"
                                VerticalAlignment="Center"
                                Click="OpenSettingsClick"
                                AutomationProperties.AutomationId="OpenSettingsButton" />
                    </Grid>
                </Border>
                <Border x:Name="InstallPanel" Grid.Row="1" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="설치는 아래 버튼을 눌러야 시작됩니다." />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8" Text="winget install --id Microsoft.PowerToys -e" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="winget으로 설치"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="WingetClick"
                                    AutomationProperties.AutomationId="WingetInstallButton" />
                            <Button Content="Microsoft Store 열기"
                                    Style="{StaticResource ActionButton}"
                                    Click="StoreClick"
                                    AutomationProperties.AutomationId="StoreButton" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0" VerticalAlignment="Stretch">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="항상 적용" Style="{StaticResource SectionTitle}" FontSize="12" Margin="0,0,8,0" />
                                <ItemsControl x:Name="AlwaysList" FontSize="12" AutomationProperties.AutomationId="AlwaysAppliedList" />
                            </StackPanel>
                            <TextBlock Text="게임 중에는 끔" Style="{StaticResource SectionTitle}" FontSize="12" />
                            <ItemsControl x:Name="ShortcutList" FontSize="11" AutomationProperties.AutomationId="ShortcutList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                            <TextBlock FontSize="11" TextWrapping="NoWrap">
                                                <Run Text="{Binding From}" FontWeight="SemiBold" />
                                                <Run Text=" → " />
                                                <Run Text="{Binding To}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Meaning}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Margin="8,0,0,0"
                                                       TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" VerticalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="적용 게임" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Muted}"
                                       Margin="0,0,0,8"
                                       Text="경로는 참고입니다. 전경 프로세스 이름이 같으면 게임으로 봅니다. .exe 는 있어도 되고 없어도 됩니다." />
                            <Border BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Background="{DynamicResource ListBackground}"
                                    ClipToBounds="True"
                                    SnapsToDevicePixels="True">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top"
                                            Background="{DynamicResource ButtonBackground}"
                                            BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="0,0,0,1">
                                        <Grid Height="32">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="148" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="프로세스"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0" />
                                            <Border Grid.Column="1"
                                                    BorderBrush="{DynamicResource CardBorder}"
                                                    BorderThickness="1,0,0,0">
                                                <TextBlock Text="경로"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="EmptyGamesText"
                                               DockPanel.Dock="Top"
                                               Style="{StaticResource Muted}"
                                               Margin="10,8"
                                               Text="추가된 게임이 없습니다." />
                                    <ListBox x:Name="GamesView"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemContainerStyle="{StaticResource TableRow}"
                                             VirtualizingPanel.IsVirtualizing="False"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             AutomationProperties.AutomationId="GameList">
                                        <ListBox.Template>
                                            <ControlTemplate TargetType="ListBox">
                                                <ItemsPresenter />
                                            </ControlTemplate>
                                        </ListBox.Template>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="148" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ProcessName}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Margin="10,6" />
                                                    <Border Grid.Column="1"
                                                            BorderBrush="{DynamicResource CardBorder}"
                                                            BorderThickness="1,0,0,0"
                                                            Padding="10,6">
                                                        <TextBlock Text="{Binding PathText}"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip="{Binding PathText}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="실행 중인 프로세스에서 추가"
                                        Style="{StaticResource ActionButton}"
                                        Click="AddRunningClick"
                                        AutomationProperties.AutomationId="AddRunningButton" />
                                <Button Content="exe 파일 선택"
                                        Style="{StaticResource ActionButton}"
                                        Click="AddFileClick"
                                        AutomationProperties.AutomationId="AddFileButton" />
                                <Button Content="제거"
                                        Style="{StaticResource ActionButton}"
                                        Click="RemoveGameClick"
                                        AutomationProperties.AutomationId="RemoveGameButton" />
                            </WrapPanel>
                            <CheckBox x:Name="StartWithWindowsCheck"
                                      Content="로그인할 때 시작"
                                      Foreground="{DynamicResource TextPrimary}"
                                      Margin="2,4,0,0"
                                      Checked="StartWithWindowsChanged"
                                      Unchecked="StartWithWindowsChanged"
                                      AutomationProperties.AutomationId="StartWithWindows" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <Border Background="{DynamicResource WarnBackground}"
                            BorderBrush="{DynamicResource WarnForeground}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8">
                        <TextBlock x:Name="WarningText"
                                   Foreground="{DynamicResource WarnForeground}"
                                   TextWrapping="Wrap"
                                   Text="PowerToys에서 키를 바꿔도, 적용하거나 다시 시작하면 위 목록으로 돌아갑니다. 특정 앱에만 넣은 단축키는 남습니다." />
                    </Border>
                    <TextBlock x:Name="ActionStatusText"
                               Style="{StaticResource Muted}"
                               Margin="2,8,0,0"
                               AutomationProperties.AutomationId="ActionStatus" />
                    <TextBlock Style="{StaticResource Muted}"
                               Margin="2,4,0,0"
                               Text="창을 닫아도 트레이에 남습니다. 끝내려면 트레이 아이콘에서 종료를 고르세요." />
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
